# HOLO gateway configuration. Copy to .env (git-ignored) and fill in.
# Every value can also be a real environment variable of the same name.

# --- Required ---------------------------------------------------------------
# The server's OpenRouter key. Lives only here, never on the phone.
OPENROUTER_API_KEY=
# The public edition's Supabase project (separate from the personal one).
# SUPABASE_URL enables asymmetric keys (JWKS) and the issuer check; the secret
# enables HS256 tokens. Set either or both.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Storage ----------------------------------------------------------------
# Local dev: SQLite file. docker-compose overrides this with its Postgres.
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=
# The domain Caddy serves (and gets a TLS certificate for) in docker-compose.
GATEWAY_DOMAIN=gateway.example.com

# --- Admin and billing --------------------------------------------------------
# Long random strings. Empty disables the endpoint.
ADMIN_TOKEN=
PLAY_PUSH_TOKEN=
# Ignore Play notifications for any other package when set.
PLAY_PACKAGE_NAME=
# JSON. Defaults shown.
# PLAY_PRODUCT_PLANS={"holo_side_quest":"side_quest","holo_main_character":"main_character","holo_final_boss":"final_boss","holo_god_mode":"god_mode"}
# PLAY_TOPUP_PRODUCTS={"holo_aura_150":150}

# --- Aura -----------------------------------------------------------------------
# 1 Aura = Rs AURA_INR of provider cost.
AURA_INR=0.10
USD_INR=88
# Comma-separated. Empty = every model in the price table.
ALLOWED_MODELS=
# JSON, merged per model over the built-in table (USD per token / second / char).
# MODEL_PRICES={"openai/gpt-6-luna":{"prompt":0.0000001,"cached_prompt":0.00000001,"completion":0.0000005}}
# Charge OpenRouter's own reported cost when it is higher than the table's.
CHARGE_UPSTREAM_COST_IF_HIGHER=true
# Minimum balance (Aura) to forward a request; audio reserves max(this, estimate).
RESERVE_AURA_CHAT=1.0
RESERVE_AURA_STT=0.1
RESERVE_AURA_TTS=0.1
RESERVATION_TTL_SECONDS=900
# All free users together may spend at most this much Aura per IST day
# (x Rs 0.10 = your worst-case free cost per day). 0 = no pool.
FREE_POOL_DAILY_AURA=500

# --- Plans and limits -------------------------------------------------------------
# JSON, per plan: name, price_inr, monthly_aura, rpm, daily_cap_aura.
# PLAN_OVERRIDES={"spawn":{"rpm":20,"daily_cap_aura":15}}
TRIAL_LOCKIN_DAYS=3
PLAN_EXPIRY_GRACE_MINUTES=60
DAILY_CAP_UTC_OFFSET_MINUTES=330
MAX_BODY_BYTES=8388608
MAX_OUTPUT_TOKENS=4096
TTS_MAX_CHARS=4000
ALLOW_WEB_PLUGIN=false
ALLOW_ANONYMOUS_USERS=false

# --- HTTP -------------------------------------------------------------------------
CORS_ORIGINS=http://tauri.localhost,tauri://localhost,https://tauri.localhost
APP_NAME=HOLO
LOG_LEVEL=INFO
ENABLE_DOCS=false
