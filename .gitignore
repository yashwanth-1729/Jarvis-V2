# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Secrets & local config ------------------------------------------------
.env
.env.local
!.env.example
!.env.local.example

# --- Database --------------------------------------------------------------
backend/storage/*.db
backend/storage/*.db-wal
backend/storage/*.db-shm
# Snapshot copies of the live database. The *.db rule above does not
# cover them, so a `git add -A` would otherwise commit personal data.
backend/storage/*.db.bak
backend/storage/*.db.pre-sync-*
backend/storage/*.db.*.bak
backend/storage/memory-vault/

# --- Node / Next -----------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local UI previews (isolated fixtures and device screenshots)
/tmp/mobile-review/

# Piper voice models — large ONNX binaries, fetched per machine (see explanations.md)
backend/models/piper/*.onnx
backend/models/piper/*.onnx.json
backend/.piptmp/

# Android Piper assets fetched by backend/tools/android/setup_piper.ps1 (large, not committed)
frontend/src-tauri/gen/android/app/libs/*.aar
frontend/src-tauri/gen/android/app/src/main/assets/piper/
