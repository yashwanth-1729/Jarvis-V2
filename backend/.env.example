# ---------------------------------------------------------------------------
# JARVIS 3 - backend configuration
# Copy to `.env` and fill in SARVAM_API_KEY. Everything else has a default.
#
# NEVER commit `.env`. It is gitignored; keep it that way.
# ---------------------------------------------------------------------------

# --- Provider selection ----------------------------------------------------
# Each capability switches independently, so the roadmap is env-only:
#   v1  all three -> sarvam
#   v2  stt/tts   -> gangi        (chat stays on sarvam)
#   v3  chat      -> anthropic / openai
JARVIS_CHAT_PROVIDER=sarvam
JARVIS_STT_PROVIDER=sarvam
JARVIS_TTS_PROVIDER=sarvam

# --- Sarvam ----------------------------------------------------------------
# Required. https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_...

SARVAM_BASE_URL=https://api.sarvam.ai

# sarvam-105b                128K context, reasons before answering. Best for
#                            agentic tool use - the default.
# sarvam-105b-conversations  post-trained for real-time dialogue; emits no
#                            reasoning tokens, so it is markedly faster. Prefer
#                            it if you drive JARVIS mostly by voice.
SARVAM_CHAT_MODEL=sarvam-105b

# Speech models.
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# NOTE: bulbul:v2 and bulbul:v3 have DIFFERENT speaker sets. `shubh` is the
# bulbul:v3 default. If you switch model versions and the speaker is invalid,
# the server logs a warning and falls back to the model default rather than
# failing the request.
SARVAM_TTS_SPEAKER=shubh

# BCP-47. Also used as the STT hint and the TTS output language.
SARVAM_LANGUAGE=en-IN

# low | medium | high - or blank to use the model default.
SARVAM_REASONING_EFFORT=low
SARVAM_TEMPERATURE=0.2

SARVAM_CHAT_TIMEOUT=45
# Longer read allowance used only for large typed prompts.
SARVAM_LONG_CHAT_TIMEOUT=120
SARVAM_SPEECH_TIMEOUT=90

# --- Agent loop ------------------------------------------------------------
# IMPORTANT: reasoning tokens bill against this budget. A small ceiling returns
# an empty reply with finish_reason "length" - the model spends the whole
# allowance thinking and never emits visible text. 4000 is a safe floor.
JARVIS_MAX_TOKENS=4000

# Max tool-execution round trips per user message before the loop hard-stops.
JARVIS_MAX_TOOL_ITERATIONS=8

# How many past chat messages to replay into the model on each turn.
JARVIS_HISTORY_LIMIT=40

# Whole typed turn, including tool calls. The stream closes with an error when
# this ceiling is reached instead of leaving the composer loading forever.
# Whole-turn ceiling across every model/tool round. SSE heartbeats keep the UI live.
JARVIS_CHAT_TURN_TIMEOUT=240
# Large typed prompts stream progressively instead of waiting for one full response.
JARVIS_TYPED_STREAM_CHARS=4000

# --- Acting on this machine ------------------------------------------------
# Lets JARVIS run shell commands and read, write and edit files:
#   run_command  read_file  write_file  edit_file  list_dir  search_files
#
# READ THIS BEFORE LEAVING IT ON.
#
# There is no sandbox. These run with your user's full permissions — the same
# access you have. JARVIS asks before anything unrecoverable (recursive delete,
# force push, overwriting a file) and logs every invocation, but that guards
# against carelessness, not against a determined instruction. Anything JARVIS
# reads — a web page, a file, a message someone sent you — is text a model will
# act on, and a model can be talked into things.
#
# Turning it off returns JARVIS to working only on its own tasks, schedule and
# notes, which is what it did before. It is forced off inside the Android app
# regardless of this setting: that process is sandboxed and a shell there
# reaches nothing worth reaching.
#
# It also costs roughly 1,400 tokens per request to describe these six tools to
# the model — about 30% on top of the existing catalogue — so turn it off if you
# are not using it.
JARVIS_SYSTEM_TOOLS=true

# --- Speaking up -----------------------------------------------------------
# Makes the schedule act instead of merely existing. A background loop watches
# the timetable, your routines, one-off reminders and task deadlines, and queues
# an announcement shortly before each one — which the app then delivers.
#
# Nothing to configure and no cron expressions to write: it fires from the rows
# you already created by talking to JARVIS. Set it false and JARVIS goes back to
# knowing your week without ever acting on it.
#
# Forced off inside the Android app, which is foreground-only by design.
JARVIS_SCHEDULER_ENABLED=true

# --- Voice -----------------------------------------------------------------
JARVIS_VOICE_ENABLED=true
# New realtime clients request incremental PCM speech; false restores WAV TTS.
JARVIS_STREAMING_TTS=true
JARVIS_MAX_AUDIO_MB=15

# --- Storage ---------------------------------------------------------------
# Relative paths resolve against backend/
JARVIS_DB_PATH=storage/jarvis_memory.db
JARVIS_DB_POOL_SIZE=5

# --- Server ----------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Comma-separated list of allowed browser origins for the API.
JARVIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Cross-device sync (Supabase mirror) ---------------------------------
# Optional. Leave SUPABASE_SERVICE_KEY blank to run fully standalone.
# Project Settings -> API -> service_role. This key bypasses row-level
# security. As of 2026-09-12, every JARVIS platform runs client-owned-data
# (see JARVIS_CLIENT_OWNED_DATA below): sync itself runs in the frontend
# (frontend/src/lib/syncClient.ts), not this backend. These two values still
# belong here because GET /api/local/sync-bootstrap reads them and hands
# them to the frontend once, over localhost, on first launch -- so you only
# ever type your Supabase credentials in one place.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# True on every JARVIS build now: the frontend's local storage (IndexedDB in
# the WebView) is authoritative for the user's data, and this backend's
# SQLite is a disposable working copy seeded from it. Leaving this false is
# unsupported since the backend-side sync engine was removed -- nothing
# publishes local writes anywhere if this is false and JARVIS_CLIENT_OWNED_DATA
# stays unset.
JARVIS_CLIENT_OWNED_DATA=true
